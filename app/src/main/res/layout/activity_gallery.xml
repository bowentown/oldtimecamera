<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/film_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top archive bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/galleryBack"
                style="@style/TopIconButton"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_title" />

                <TextView
                    android:id="@+id/gallerySubtitle"
                    style="@style/TextMonoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/gallerySheetToggle"
                style="@style/TextMonoCaption"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gallery_contact_sheet"
                android:textColor="@color/paper" />
        </LinearLayout>

        <!-- Contact sheet instruction / export bar -->
        <LinearLayout
            android:id="@+id/sheetSelectBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/film_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                style="@style/TextCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gallery_select_hint" />

            <TextView
                android:id="@+id/makeSheetButton"
                style="@style/TextMonoCaption"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_segment_active"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/ink"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Photo grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/galleryGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:horizontalSpacing="4dp"
                android:numColumns="3"
                android:padding="8dp"
                android:verticalSpacing="4dp" />

            <TextView
                android:id="@+id/galleryEmpty"
                style="@style/TextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:padding="32dp"
                android:text="@string/gallery_empty"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Full-screen Lightbox Viewer -->
    <FrameLayout
        android:id="@+id/lightboxOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F511100E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/lightboxImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingTop="68dp"
            android:paddingEnd="16dp"
            android:paddingBottom="116dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/lightboxMeta"
            style="@style/TextMonoCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="72dp"
            android:background="@drawable/bg_assist_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="320dp"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:singleLine="true"
            android:textColor="@color/paper_soft"
            android:visibility="gone" />

        <!-- Collapsible BYOK AI Critique card -->
        <LinearLayout
            android:id="@+id/lightboxAiCard"
            android:layout_width="316dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="104dp"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/amber_led" />

                <TextView
                    style="@style/TextMonoCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_critique_title"
                    android:textColor="@color/amber_led" />

                <TextView
                    android:id="@+id/lightboxAiRetry"
                    style="@style/TextMonoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_pill_ripple"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/ai_critique_retry"
                    android:textColor="@color/paper_dim" />

                <ImageButton
                    android:id="@+id/lightboxAiDismiss"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_hud_icon_button"
                    android:contentDescription="@string/close"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/paper_dim" />
            </LinearLayout>

            <TextView
                android:id="@+id/lightboxAiStatus"
                style="@style/TextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/paper_soft"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lightboxAiRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lightboxAiGood"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/paper" />

                <TextView
                    android:id="@+id/lightboxAiIssue"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/paper_soft" />

                <TextView
                    android:id="@+id/lightboxAiNext"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/amber_led" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/lightboxClose"
                style="@style/TopIconButton"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/lightboxTitle"
                style="@style/TextMonoLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/paper_dim" />

            <Space
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_hud_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/lightboxShare"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hud_icon_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_share"
                    android:tint="@color/paper" />

                <TextView
                    style="@style/TextMonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/gallery_share" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:id="@+id/lightboxDelete"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hud_icon_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_delete"
                    android:tint="@color/paper_dim" />

                <TextView
                    style="@style/TextMonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/gallery_delete"
                    android:textColor="@color/paper_dim" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:id="@+id/lightboxAiCritique"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hud_icon_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/amber_led" />

                <TextView
                    style="@style/TextMonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/gallery_ai_critique"
                    android:textColor="@color/amber_led" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
