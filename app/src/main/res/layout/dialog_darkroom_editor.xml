<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/film_black"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/editorClose"
            style="@style/TopIconButton"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/editorTitle"
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/editor_title" />

        <TextView
            android:id="@+id/editorSave"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_segment_active"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/editor_save"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preview image (press & hold to compare raw original) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <ImageView
            android:id="@+id/editorPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/editor_hold_compare_hint"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/editorCompareBadge"
            style="@style/TextMonoCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hud_bar"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/hint_comparing_original"
            android:textColor="@color/amber_led"
            android:visibility="gone" />

        <TextView
            android:id="@+id/editorBusy"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_hud_bar"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/editor_developing"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Darkroom controls: Paper / Date / WB + Note + Film Stock Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/film_dark"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editorPaperPill"
                style="@style/TextMonoCaption"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_segment_container"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/paper" />

            <TextView
                android:id="@+id/editorDatePill"
                style="@style/TextMonoCaption"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_segment_container"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/paper" />

            <SeekBar
                android:id="@+id/editorWbSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:max="20"
                android:progress="10"
                android:progressTint="@color/amber_led"
                android:thumbTint="@color/paper" />

            <TextView
                android:id="@+id/editorWbValue"
                style="@style/TextMonoCaption"
                android:layout_width="46dp"
                android:layout_height="30dp"
                android:gravity="center_vertical|end"
                android:textColor="@color/amber_led" />
        </LinearLayout>

        <EditText
            android:id="@+id/editorNoteInput"
            style="@style/TextCaption"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_segment_container"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:hint="@string/editor_note_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="36"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/paper"
            android:textColorHint="@color/paper_muted" />

        <HorizontalScrollView
            android:id="@+id/editorFilmScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/editorChipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
