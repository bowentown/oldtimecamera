<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_title" />

        <TextView
            android:id="@+id/sheetDoneButton"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/done" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_aspect" />

            <LinearLayout
                android:id="@+id/segAspect"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="4dp" />

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_paper" />

            <LinearLayout
                android:id="@+id/segPaper"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="4dp" />

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_date" />

            <LinearLayout
                android:id="@+id/segDate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="4dp" />

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_options" />

            <LinearLayout
                android:id="@+id/toggleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_container"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_assist" />

            <LinearLayout
                android:id="@+id/assistToggleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment_container"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                style="@style/SheetSectionLabel"
                android:text="@string/sheet_calibration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheetRotateButton"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/sheetNewRollButton"
                    style="@style/TextMonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/load_new_roll"
                    android:textColor="@color/amber_led" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheetLicensesButton"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center"
                    android:text="@string/licenses_entry" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/sheetUpdateButton"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center"
                    android:text="@string/check_update" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
