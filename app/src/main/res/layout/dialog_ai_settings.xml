<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_title" />

        <TextView
            android:id="@+id/aiCloseButton"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/close" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/ai_privacy_note"
                android:textColor="@color/paper_dim" />

            <LinearLayout
                android:id="@+id/aiProviderSeg"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextMonoCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_label_key"
                    android:textColor="@color/paper_dim" />

                <TextView
                    android:id="@+id/aiKeyStatus"
                    style="@style/TextMonoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/amber_led" />
            </LinearLayout>

            <EditText
                android:id="@+id/aiKeyInput"
                style="@style/TextCaption"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:hint="@string/ai_key_hint_new"
                android:imeOptions="actionNext"
                android:inputType="text|textPassword|textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/paper"
                android:textColorHint="@color/paper_muted" />

            <TextView
                style="@style/TextMonoCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ai_label_url"
                android:textColor="@color/paper_dim" />

            <EditText
                android:id="@+id/aiBaseUrlInput"
                style="@style/TextCaption"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:imeOptions="actionNext"
                android:inputType="textUri|textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/paper"
                android:textColorHint="@color/paper_muted" />

            <TextView
                style="@style/TextMonoCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ai_label_model"
                android:textColor="@color/paper_dim" />

            <EditText
                android:id="@+id/aiModelInput"
                style="@style/TextCaption"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_container"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:imeOptions="actionDone"
                android:inputType="text|textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/paper"
                android:textColorHint="@color/paper_muted" />

            <LinearLayout
                android:id="@+id/aiVisionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_segment_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_label_vision" />

                <Switch
                    android:id="@+id/aiVisionSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    android:thumb="@drawable/bg_switch_thumb"
                    android:track="@drawable/bg_switch_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiTestStatus"
                style="@style/TextMonoCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/paper_soft"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aiClearKeyBtn"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center"
                    android:text="@string/ai_clear_key"
                    android:textColor="@color/paper_dim" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/aiTestBtn"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_action_button"
                    android:gravity="center"
                    android:text="@string/ai_test" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/aiSaveBtn"
                    style="@style/TextMonoLabel"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_segment_active"
                    android:gravity="center"
                    android:text="@string/ai_save"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
