<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/film_black">

    <!-- Live camera preview with the film shader applied on every frame. -->
    <com.bowentown.oldtimecamera.FilmCameraView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Dim scrim behind the controls so the UI stays readable. -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="#66000000" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_gravity="bottom"
        android:background="#99000000" />

    <!-- ============ TOP BAR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <com.bowentown.oldtimecamera.PerforationView
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/flashButton"
                style="@style/TopButton"
                android:text="@string/flash_auto" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:letterSpacing="0.18"
                    android:text="OLD TIME CAMERA"
                    android:textColor="@color/paper"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/rollCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="ROLL 01 · EXP 00"
                    android:textColor="@color/paper_dim"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/switchButton"
                style="@style/TopButton"
                android:text="SW" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/settingsButton"
                style="@style/TopButton"
                android:text="SET" />
        </LinearLayout>
    </LinearLayout>

    <!-- In-viewfinder stamp preview (the real stamp is baked into the saved JPEG). -->
    <TextView
        android:id="@+id/dateStamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="222dp"
        android:alpha="0.85"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:shadowColor="#99000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#F2A65A"
        android:textSize="13sp" />

    <!-- ============ BOTTOM PANEL ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <com.bowentown.oldtimecamera.PerforationView
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/presetCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textColor="@color/paper_dim"
            android:textSize="10sp"
            android:text="FILM STOCK" />

        <HorizontalScrollView
            android:id="@+id/filmStripScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <!-- Shutter row -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp">

            <FrameLayout
                android:id="@+id/thumbnailFrame"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@string/thumbnail">

                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/shutterButton"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_ring"
                android:contentDescription="@string/shutter">

                <View
                    android:id="@+id/shutterCore"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_core" />
            </FrameLayout>

            <TextView
                android:id="@+id/frameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/paper_dim"
                android:textSize="11sp"
                android:text="00 / 36" />
        </FrameLayout>
    </LinearLayout>

    <!-- Shutter flash overlay -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/paper"
        android:clickable="false"
        android:focusable="false" />

    <!-- Permission gate -->
    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.96"
        android:background="@color/film_black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/app_name"
            android:textColor="@color/paper"
            android:textSize="24sp" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/camera_permission_needed"
            android:textColor="@color/paper_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/grantButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/grant_permission"
            android:textColor="@color/paper" />
    </LinearLayout>

</FrameLayout>
