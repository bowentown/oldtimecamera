<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/film_black">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ TOP BAR ============ -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/flashButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/flash"
                android:src="@drawable/ic_flash_auto" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/timerButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/hud_timer_off">

                <ImageView
                    android:id="@+id/timerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_timer"
                    android:tint="@color/paper" />

                <TextView
                    android:id="@+id/timerLabel"
                    style="@style/TextMonoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/amber_led"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rollCounter"
                    style="@style/TextMonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/roll_placeholder"
                    android:textColor="@color/paper_dim" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/switchButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/switch_camera"
                android:src="@drawable/ic_flip_camera" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- ============ VIEWFINDER STAGE ============ -->
        <FrameLayout
            android:id="@+id/viewfinderStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.bowentown.oldtimecamera.AspectFrameLayout
                android:id="@+id/previewHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <com.bowentown.oldtimecamera.FilmCameraView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <com.bowentown.oldtimecamera.ViewfinderOverlayView
                    android:id="@+id/viewfinderOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <ImageButton
                    android:id="@+id/poseGuideButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.80"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/hud_pose_guide"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pose_guide"
                    android:tint="@color/paper" />

                <ImageButton
                    android:id="@+id/aiInspireButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="44dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.82"
                    android:background="@drawable/bg_round_button"
                    android:contentDescription="@string/hud_ai_inspire"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/amber_led" />

                <TextView
                    android:id="@+id/dateStamp"
                    style="@style/TextMonoStamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.88"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
            </com.bowentown.oldtimecamera.AspectFrameLayout>

            <!-- Single non-stacked floating assist hint pill -->
            <TextView
                android:id="@+id/assistHintPill"
                style="@style/AssistHintPill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:alpha="0"
                android:visibility="gone" />

            <!-- Self-timer countdown overlay -->
            <TextView
                android:id="@+id/countdownText"
                style="@style/TextMonoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:shadowColor="#CC000000"
                android:shadowRadius="12"
                android:visibility="gone" />

            <!-- Passive dismissible scene film recommendation chip near film strip -->
            <LinearLayout
                android:id="@+id/sceneRecommendChip"
                style="@style/SceneRecommendChip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:alpha="0"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/amber_led" />

                <TextView
                    android:id="@+id/sceneRecommendLabel"
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/paper" />

                <ImageButton
                    android:id="@+id/sceneRecommendClose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_hud_icon_button"
                    android:contentDescription="@string/close"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="@color/paper_dim" />
            </LinearLayout>

            <!-- Optional EV slider drawer floating unobtrusively at bottom of stage -->
            <LinearLayout
                android:id="@+id/evPanel"
                android:layout_width="244dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_hud_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    style="@style/TextMonoCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ev_label" />

                <SeekBar
                    android:id="@+id/evSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="@color/amber_led"
                    android:thumbTint="@color/paper" />

                <TextView
                    android:id="@+id/evValueText"
                    style="@style/TextMonoCaption"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/ev_zero"
                    android:textColor="@color/amber_led" />
            </LinearLayout>

            <!-- Post-shot single-line micro-review pill (non-blocking) -->
            <TextView
                android:id="@+id/postShotReviewPill"
                style="@style/AssistHintPill"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:alpha="0"
                android:clickable="true"
                android:focusable="true"
                android:maxWidth="312dp"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- On-demand AI framing inspiration pill (tap-triggered only) -->
            <TextView
                android:id="@+id/aiInspirePill"
                style="@style/TextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:alpha="0"
                android:background="@drawable/bg_assist_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:maxWidth="308dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/amber_led"
                android:visibility="gone" />

            <!-- Long-press shooting mode bar (1x / 2x / 1/2 / 4F) -->
            <LinearLayout
                android:id="@+id/modePickerBar"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_hud_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/modePickSingle"
                    style="@style/HudPill"
                    android:text="@string/mode_single" />

                <View style="@style/HudDivider" />

                <TextView
                    android:id="@+id/modePickDouble"
                    style="@style/HudPill"
                    android:text="@string/mode_double" />

                <View style="@style/HudDivider" />

                <TextView
                    android:id="@+id/modePickHalf"
                    style="@style/HudPill"
                    android:text="@string/mode_half" />

                <View style="@style/HudDivider" />

                <TextView
                    android:id="@+id/modePickQuad"
                    style="@style/HudPill"
                    android:text="@string/mode_quad" />
            </LinearLayout>

            <!-- Inline Film Recipe drawer (long-press any stock chip) -->
            <LinearLayout
                android:id="@+id/recipePanel"
                android:layout_width="312dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_sheet"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/recipePanelTitle"
                        style="@style/TextMonoCaption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/paper" />

                    <TextView
                        android:id="@+id/recipeAiBtn"
                        style="@style/TextMonoCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_pill_ripple"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="@string/recipe_ai_btn"
                        android:textColor="@color/amber_led" />

                    <TextView
                        android:id="@+id/recipeResetBtn"
                        style="@style/TextMonoCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_pill_ripple"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="@string/recipe_reset"
                        android:textColor="@color/paper_dim" />

                    <TextView
                        android:id="@+id/recipeSaveBtn"
                        style="@style/TextMonoCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/bg_pill_ripple"
                        android:gravity="center"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:text="@string/recipe_save"
                        android:textColor="@color/paper" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextMonoCaption"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_intensity"
                        android:textColor="@color/paper_dim" />

                    <SeekBar
                        android:id="@+id/recipeIntensitySeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/amber_led"
                        android:thumbTint="@color/paper" />

                    <TextView
                        android:id="@+id/recipeIntensityVal"
                        style="@style/TextMonoCaption"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/amber_led" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextMonoCaption"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_grain"
                        android:textColor="@color/paper_dim" />

                    <SeekBar
                        android:id="@+id/recipeGrainSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="200"
                        android:progress="100"
                        android:progressTint="@color/amber_led"
                        android:thumbTint="@color/paper" />

                    <TextView
                        android:id="@+id/recipeGrainVal"
                        style="@style/TextMonoCaption"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/amber_led" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextMonoCaption"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/recipe_warmth"
                        android:textColor="@color/paper_dim" />

                    <SeekBar
                        android:id="@+id/recipeWarmthSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="20"
                        android:progress="10"
                        android:progressTint="@color/amber_led"
                        android:thumbTint="@color/paper" />

                    <TextView
                        android:id="@+id/recipeWarmthVal"
                        style="@style/TextMonoCaption"
                        android:layout_width="38dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/amber_led" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ============ BOTTOM CAMERA CHASSIS ============ -->
        <LinearLayout
            android:id="@+id/bottomDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/film_black"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Compact 12-bin histogram + analog light meter needle bar -->
            <com.bowentown.oldtimecamera.MeterStripView
                android:id="@+id/meterStrip"
                android:layout_width="228dp"
                android:layout_height="22dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="6dp"
                android:contentDescription="@string/hud_meter_bar" />

            <!-- Micro HUD capsule bar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_hud_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/zoomPill"
                    style="@style/HudPill"
                    android:text="@string/zoom_default" />

                <View style="@style/HudDivider" />

                <TextView
                    android:id="@+id/aspectPill"
                    style="@style/HudPill"
                    android:text="@string/aspect_default" />

                <View style="@style/HudDivider" />

                <TextView
                    android:id="@+id/evPill"
                    style="@style/HudPill"
                    android:text="@string/ev_pill_zero" />

                <View style="@style/HudDivider" />

                <ImageButton
                    android:id="@+id/gridPill"
                    android:layout_width="34dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_hud_icon_button"
                    android:contentDescription="@string/hud_grid"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_grid"
                    android:tint="@color/paper" />

                <View style="@style/HudDivider" />

                <ImageButton
                    android:id="@+id/modePill"
                    android:layout_width="34dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_hud_icon_button"
                    android:contentDescription="@string/hud_double_exp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mode_single"
                    android:tint="@color/paper" />
            </LinearLayout>

            <!-- Film stock strip -->
            <HorizontalScrollView
                android:id="@+id/filmStripScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

            <!-- Shutter deck -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="4dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <FrameLayout
                    android:id="@+id/thumbnailFrame"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_thumb"
                    android:contentDescription="@string/thumbnail"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/thumbPlaceholder"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_film_roll"
                        android:tint="@color/paper" />

                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/shutterButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_ring"
                    android:contentDescription="@string/shutter">

                    <com.bowentown.oldtimecamera.ShutterProgressView
                        android:id="@+id/shutterProgress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:id="@+id/shutterCore"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shutter_core" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/importButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_square_button"
                    android:contentDescription="@string/darkroom_import"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_darkroom_import"
                    android:tint="@color/paper" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shutter flash overlay -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/paper"
        android:clickable="false"
        android:focusable="false" />

    <!-- Permission gate -->
    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/film_black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.12"
            android:text="@string/app_name" />

        <TextView
            style="@style/TextLabel"
            android:layout_width="256dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/camera_permission_needed"
            android:textColor="@color/paper_dim" />

        <TextView
            android:id="@+id/grantButton"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segment_active"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/grant_permission"
            android:textColor="@color/ink"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
