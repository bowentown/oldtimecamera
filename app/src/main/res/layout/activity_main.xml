<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/film_black">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============ TOP BAR ============ -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/flashButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/flash"
                android:src="@drawable/ic_flash_auto" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:id="@+id/timerButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/hud_timer_off">

                <ImageView
                    android:id="@+id/timerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_timer" />

                <TextView
                    android:id="@+id/timerLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textColor="@color/amber_led"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rollCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:text="R01 · 00/36"
                    android:textColor="@color/paper_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/switchButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/switch_camera"
                android:src="@drawable/ic_flip_camera" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/settingsButton"
                style="@style/TopIconButton"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- ============ VIEWFINDER STAGE ============ -->
        <FrameLayout
            android:id="@+id/viewfinderStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.bowentown.oldtimecamera.AspectFrameLayout
                android:id="@+id/previewHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <com.bowentown.oldtimecamera.FilmCameraView
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <com.bowentown.oldtimecamera.ViewfinderOverlayView
                    android:id="@+id/viewfinderOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/dateStamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.88"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.10"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="@color/amber_led"
                    android:textSize="13sp" />
            </com.bowentown.oldtimecamera.AspectFrameLayout>

            <!-- Self-timer countdown overlay -->
            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:shadowColor="#CC000000"
                android:shadowRadius="12"
                android:textColor="@color/paper"
                android:textSize="64sp"
                android:visibility="gone" />

            <!-- Optional EV slider drawer floating unobtrusively at bottom of stage -->
            <LinearLayout
                android:id="@+id/evPanel"
                android:layout_width="240dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_hud_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="EV"
                    android:textColor="@color/paper_dim"
                    android:textSize="10sp" />

                <SeekBar
                    android:id="@+id/evSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progressTint="@color/amber_led"
                    android:thumbTint="@color/paper" />

                <TextView
                    android:id="@+id/evValueText"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="0.0"
                    android:textColor="@color/amber_led"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============ BOTTOM CAMERA CHASSIS ============ -->
        <LinearLayout
            android:id="@+id/bottomDeck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/film_black"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <!-- Micro HUD capsule bar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_hud_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/zoomPill"
                    style="@style/HudPill"
                    android:text="1.0x" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/hairline" />

                <TextView
                    android:id="@+id/aspectPill"
                    style="@style/HudPill"
                    android:text="3:4" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/hairline" />

                <TextView
                    android:id="@+id/evPill"
                    style="@style/HudPill"
                    android:text="EV 0" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/hairline" />

                <ImageButton
                    android:id="@+id/gridPill"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/hud_grid"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_grid" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="@color/hairline" />

                <ImageButton
                    android:id="@+id/doubleExposurePill"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/hud_double_exp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_double_exposure" />
            </LinearLayout>

            <!-- Film stock strip -->
            <HorizontalScrollView
                android:id="@+id/filmStripScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </HorizontalScrollView>

            <!-- Shutter deck -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="4dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp">

                <FrameLayout
                    android:id="@+id/thumbnailFrame"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_thumb"
                    android:clipToOutline="true"
                    android:contentDescription="@string/thumbnail"
                    android:padding="2dp">

                    <ImageView
                        android:id="@+id/thumbPlaceholder"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_film_roll" />

                    <ImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/shutterButton"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_ring"
                    android:contentDescription="@string/shutter">

                    <View
                        android:id="@+id/shutterCore"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shutter_core" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/importButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_square_button"
                    android:contentDescription="@string/darkroom_import"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_darkroom_import" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shutter flash overlay -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/paper"
        android:clickable="false"
        android:focusable="false" />

    <!-- Permission gate -->
    <LinearLayout
        android:id="@+id/permissionGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/film_black"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="serif"
            android:letterSpacing="0.1"
            android:text="@string/app_name"
            android:textColor="@color/paper"
            android:textSize="22sp" />

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@string/camera_permission_needed"
            android:textColor="@color/paper_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/grantButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segment_active"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/grant_permission"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
