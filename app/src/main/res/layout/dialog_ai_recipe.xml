<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_recipe_title" />

        <TextView
            android:id="@+id/aiRecipeCloseBtn"
            style="@style/TextMonoLabel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aiRecipeTag1"
            style="@style/TextMonoCaption"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/ai_recipe_tag_1" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/aiRecipeTag2"
            style="@style/TextMonoCaption"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/ai_recipe_tag_2" />

        <Space
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/aiRecipeTag3"
            style="@style/TextMonoCaption"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/ai_recipe_tag_3" />
    </LinearLayout>

    <EditText
        android:id="@+id/aiRecipePromptInput"
        style="@style/TextLabel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment_container"
        android:hint="@string/ai_recipe_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="80"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/paper"
        android:textColorHint="@color/paper_muted" />

    <TextView
        android:id="@+id/aiRecipeStatus"
        style="@style/TextMonoCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/amber_led"
        android:visibility="gone" />

    <TextView
        android:id="@+id/aiRecipeGenerateBtn"
        style="@style/TextMonoLabel"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_segment_active"
        android:gravity="center"
        android:text="@string/ai_recipe_generate"
        android:textColor="@color/ink"
        android:textStyle="bold" />
</LinearLayout>
