<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/film_black</item>
        <item name="android:statusBarColor">@color/film_black</item>
        <item name="android:navigationBarColor">@color/film_black</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="FilmLabel">
        <item name="android:textColor">@color/paper</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TopButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_round_button</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
